{
    "name": "command-center",
    "version": "0.1.0",
    "private": true,
    "description": "Local command center for day-to-day work: tasks, artifacts, center agent, herdr workers.",
    "type": "module",
    "main": "server/src/index.js",
    "bin": {
        "cc": "cli/cc.js"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "start": "node server/src/index.js",
        "dev:web": "vite --config web/vite.config.js",
        "build:web": "vite build --config web/vite.config.js",
        "build": "npm run build:web",
        "test": "npm run test:server && npm run test:web",
        "test:coverage": "npm run test:server -- --coverage && npm run test:web -- --coverage",
        "lint": "eslint server cli web/src",
        "format": "prettier --write .",
        "test:server": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:web": "jest -c jest.web.config.js"
    },
    "author": "NorthernCaptain",
    "license": "MIT",
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.319",
        "@anthropic-ai/sdk": "^1.6.0",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "better-sqlite3": "^13.0.3",
        "chrono-node": "^2.10.3",
        "diff-match-patch": "^1.0.5",
        "express": "^5.3.0",
        "markdown-it": "^15.0.3",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "web-push": "^3.6.7",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@vitejs/plugin-react": "^6.2.1",
        "babel-jest": "^29.7.0",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^3.9.10",
        "supertest": "^7.3.2",
        "vite": "^8.3.6"
    }
}
